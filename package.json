{
  "name": "roleta",
  "version": "1.0.0",
  "private": true,
  "description": "Roleta de brindes da Convenção 2026 (Constelação OncologyGroup) para totem touch.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
